{% comment %}
  Renders a heading with arrows and a horizontal slider of product cards.
  Needs section-category-slider.css and component-card-product-simple.css.

  Accepts:
  - products: {Array} Products to show
  - section: {Object} Current section (uses title, heading_size, show_type, show_button)
  - ratio: {String} CSS aspect ratio of card images, e.g. '4 / 5'
  - limit: {Number} Maximum number of products (optional, default 8)
  - exclude_id: {Number} Product ID to leave out, e.g. the current product (optional)
  - link_label: {String} Label of a "view all" link shown next to the arrows (optional)
  - link_url: {String} URL of that link (optional)
  - autoplay_speed: {Number} Milliseconds between automatic slides; 0 or blank turns it off (optional,
    needs slider-autoplay.js)

  Products that appear more than once in `products` are shown once.

  Usage:
  {% render 'products-slider', products: recommendations.products, section: section, ratio: '4 / 5' %}
{% endcomment %}

{%- liquid
  assign max = limit | default: 8
  assign count = 0
  assign seen = ','
  for item in products
    assign key = ',' | append: item.id | append: ','
    if item.id != exclude_id and count < max
      unless seen contains key
        assign count = count | plus: 1
        assign seen = seen | append: item.id | append: ','
      endunless
    endif
  endfor
-%}

{%- if count > 0 -%}
  <slider-autoplay data-speed="{{ autoplay_speed | default: 0 }}">
  <slider-component class="category-slider__component">
    <div class="category-slider__header">
      {%- if section.settings.title != blank -%}
        <h2 class="category-slider__title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      <div class="section-heading__actions">
      {%- if link_label != blank and link_url != blank -%}
        <a href="{{ link_url }}" class="section-heading__link link link--text">
          {{- link_label | escape -}}
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </a>
      {%- endif -%}
      {%- if count > 1 -%}
        <div class="category-slider__buttons">
          <button
            type="button"
            class="category-slider__button category-slider__button--prev category-slider__button--light"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </button>
          <button
            type="button"
            class="category-slider__button category-slider__button--light"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </button>
        </div>
      {%- endif -%}
      </div>
    </div>

    <ul id="Slider-{{ section.id }}" class="category-slider__list list-unstyled" role="list">
      {%- assign shown = 0 -%}
      {%- assign seen = ',' -%}
      {%- for item in products -%}
        {%- assign key = ',' | append: item.id | append: ',' -%}
        {%- if item.id == exclude_id or shown >= max or seen contains key -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign seen = seen | append: item.id | append: ',' -%}
        <li id="Slide-{{ section.id }}-{{ shown }}" class="category-slider__item">
          {% render 'card-product-simple',
            product: item,
            section_id: section.id,
            ratio: ratio,
            sizes: '(min-width: 990px) 25vw, 75vw',
            show_type: section.settings.show_type,
            show_subtitle: false,
            show_button: section.settings.show_button
          %}
        </li>
      {%- endfor -%}
    </ul>
  </slider-component>
  </slider-autoplay>
{%- endif -%}
