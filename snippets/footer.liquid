{% doc %}
  Renders the theme's storefront footer: copyright line, footer menu,
  and optional payment icons. Rendered directly in layout/theme.liquid
  so it appears on every page. Configured in the "Header and footer"
  theme settings.
{% enddoc %}

<footer>
  <div class="footer__copyright">
    &copy;
    {{ 'now' | date: '%Y' }}
    {{ shop.name | link_to: routes.root_url }}, {{ powered_by_link }}
  </div>

  <div class="footer__links">
    {% for link in settings.footer_menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="footer__payment">
    {% if settings.footer_show_payment_icons %}
      {% for type in shop.enabled_payment_types %}
        {{ type | payment_type_svg_tag }}
      {% endfor %}
    {% endif %}
  </div>
</footer>
