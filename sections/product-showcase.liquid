{{ 'component-section-heading.css' | asset_url | stylesheet_tag }}
{{ 'component-card-product-simple.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-product-showcase.css' | asset_url | stylesheet_tag }}
{%- if section.settings.tab_content == 'collections' -%}
  {{ 'section-category-slider.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.show_button == false -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
{%- if section.settings.layout == 'slider' -%}
  <script src="{{ 'showcase-slider.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if section.blocks.size > 0 -%}
  <script src="{{ 'product-tabs.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  case section.settings.image_ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '1 / 1'
  endcase

  assign columns = section.settings.columns_desktop
  assign limit = section.settings.products_to_show
  assign sizes = '(min-width: ' | append: settings.page_width | append: 'px) calc(' | append: settings.page_width | append: 'px / ' | append: columns | append: '), (min-width: 990px) calc(100vw / ' | append: columns | append: '), 50vw'
  assign show_collections = false
  if section.settings.tab_content == 'collections'
    assign show_collections = true
  endif
  assign is_slider = false
  assign grid_class = 'product-showcase__grid list-unstyled'
  if section.settings.layout == 'slider'
    assign is_slider = true
    assign grid_class = grid_class | append: ' product-showcase__grid--slider'
  endif
  assign has_tabs = false
  if section.blocks.size > 0
    assign has_tabs = true
  endif

  comment
    On a collection page this can show the collection being viewed instead of the chosen one.
  endcomment
  assign showcase_collection = section.settings.collection
  if section.settings.use_current_collection and collection != blank
    assign showcase_collection = collection
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="product-showcase page-width section-{{ section.id }}-padding{% if show_collections and section.settings.show_collection_title == false %} product-showcase--image-only{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    style="--showcase-columns: {{ columns }}; --showcase-columns-mobile: {{ section.settings.columns_mobile }}; --category-ratio: {{ ratio }};"
  >
    {% render 'section-heading',
      title: section.settings.title,
      heading_size: section.settings.heading_size,
      link_label: section.settings.link_label,
      link_url: section.settings.link_url,
      class: 'product-showcase__heading'
    %}

    {%- capture all_panel -%}
      {%- if show_collections -%}
        {%- comment -%} Main collections: the tab collections, or the children of the section collection without tabs {%- endcomment -%}
        {%- capture grid -%}
        <ul class="{{ grid_class }}" role="list">
          {%- if has_tabs -%}
            {%- for block in section.blocks -%}
              {% render 'product-showcase-collection-cards',
                collection: block.settings.collection,
                title: block.settings.label,
                sizes: sizes
              %}
            {%- endfor -%}
          {%- else -%}
            {%- liquid
              assign children = section.settings.collection.metafields.custom.children.value | default: section.settings.collection.metafields.custom.custom_children.value
            -%}
            {%- for child in children limit: limit -%}
              <li class="product-showcase__item">
                {% render 'card-category', collection: child, sizes: sizes, placeholder_index: forloop.index %}
              </li>
            {%- else -%}
              {%- for i in (1..columns) -%}
                <li class="product-showcase__item">
                  {% render 'card-category', title: section.settings.collection.title, sizes: sizes, placeholder_index: i %}
                </li>
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
        {%- endcapture -%}
        {% render 'product-showcase-slider', content: grid, enabled: is_slider, rows: section.settings.slider_rows %}
      {%- else -%}
      {%- capture grid -%}
      <ul class="{{ grid_class }}" role="list">
        {%- liquid
          assign showcase_products = blank
          if showcase_collection != blank and showcase_collection.products_count > 0
            assign showcase_products = showcase_collection.products | uniq
          endif
        -%}
        {%- if showcase_products != blank and section.settings.sort_order == 'newest' -%}
          {%- comment -%} Newest first sorts up to 250 products of the collection by date added {%- endcomment -%}
          {%- paginate showcase_collection.products by 250 -%}
            {%- assign showcase_products = showcase_collection.products | sort: 'created_at' | reverse -%}
          {%- endpaginate -%}
        {%- endif -%}
        {%- liquid
          comment
            On a collection page with too few products, fill up from its parent and grandparent collections
            (collection metafield custom.parent, or the collection whose custom.children includes it).
          endcomment
          if section.settings.use_current_collection and collection != blank and showcase_collection.products_count < limit
            assign fill_collection = collection.metafields.custom.parent.value | default: collection.metafields.custom.custom_parent.value
            if fill_collection == blank
              comment
                No custom.parent set: use the collection that lists this one in its custom.children.
              endcomment
              for candidate in collections
                assign candidate_children = candidate.metafields.custom.children.value | default: candidate.metafields.custom.custom_children.value
                for child in candidate_children
                  if child.id == collection.id
                    assign fill_collection = candidate
                    break
                  endif
                endfor
                if fill_collection != blank
                  break
                endif
              endfor
            endif
            for level in (1..2)
              if fill_collection == blank
                break
              endif
              if showcase_products == blank
                assign showcase_products = fill_collection.products | uniq
              else
                assign extra_products = fill_collection.products | uniq
                assign showcase_products = showcase_products | concat: extra_products
              endif
              assign fill_collection = fill_collection.metafields.custom.parent.value | default: fill_collection.metafields.custom.custom_parent.value
            endfor

            comment
              Then the menu: find this collection in the fill menu, add the parent menu item's collection
              (when it links to one) and the collections next to it (e.g. Foam > Delux-1, Delux-2, ...).
            endcomment
            assign menu_parent = blank
            for link1 in linklists[section.settings.fill_menu].links
              for link2 in link1.links
                if link2.type == 'collection_link' and link2.object.id == collection.id
                  assign menu_parent = link1
                endif
                for link3 in link2.links
                  if link3.type == 'collection_link' and link3.object.id == collection.id
                    assign menu_parent = link2
                  endif
                endfor
              endfor
            endfor
            if menu_parent != blank
              if menu_parent.type == 'collection_link'
                if showcase_products == blank
                  assign showcase_products = menu_parent.object.products | uniq
                else
                  assign extra_products = menu_parent.object.products | uniq
                  assign showcase_products = showcase_products | concat: extra_products
                endif
              endif
              for sibling in menu_parent.links limit: 12
                if sibling.type == 'collection_link' and sibling.object.id != collection.id
                  if showcase_products == blank
                    assign showcase_products = sibling.object.products | uniq
                  else
                    assign extra_products = sibling.object.products | uniq
                    assign showcase_products = showcase_products | concat: extra_products
                  endif
                endif
              endfor
            endif
          endif
        -%}
        {%- if showcase_products != blank -%}
          {%- assign shown = 0 -%}
          {%- assign seen = ',' -%}
          {%- for product in showcase_products -%}
            {%- assign key = ',' | append: product.id | append: ',' -%}
            {%- if seen contains key -%}
              {%- continue -%}
            {%- endif -%}
            {%- if shown >= limit -%}
              {%- break -%}
            {%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign seen = seen | append: product.id | append: ',' -%}
            <li class="product-showcase__item">
              {% render 'card-product-simple',
                product: product,
                section_id: section.id,
                ratio: ratio,
                sizes: sizes,
                show_type: section.settings.show_type,
                show_subtitle: section.settings.show_subtitle,
                show_button: section.settings.show_button
              %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..columns) -%}
            <li class="product-showcase__item">
              {% render 'card-product-simple',
                section_id: section.id,
                ratio: ratio,
                placeholder_index: i,
                show_button: section.settings.show_button
              %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- endcapture -%}
      {% render 'product-showcase-slider', content: grid, enabled: is_slider, rows: section.settings.slider_rows %}
      {%- if section.settings.button_label != blank and showcase_collection.products_count > limit -%}
        <div class="product-showcase__footer">
          <a
            href="{{ section.settings.button_link | default: showcase_collection.url }}"
            class="product-showcase__button button"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- if has_tabs -%}
      <product-tabs class="product-showcase__tabs">
        <div class="product-showcase__tablist" role="tablist">
          <button
            type="button"
            role="tab"
            id="Tab-{{ section.id }}-all"
            class="product-showcase__tab"
            aria-selected="true"
            aria-controls="TabPanel-{{ section.id }}-all"
          >
            {{ section.settings.all_tab_label | escape }}
          </button>
          {%- for block in section.blocks -%}
            <button
              type="button"
              role="tab"
              id="Tab-{{ section.id }}-{{ block.id }}"
              class="product-showcase__tab"
              aria-selected="false"
              aria-controls="TabPanel-{{ section.id }}-{{ block.id }}"
              tabindex="-1"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | default: block.settings.collection.title | escape }}
            </button>
          {%- endfor -%}
        </div>

        <div
          id="TabPanel-{{ section.id }}-all"
          class="product-showcase__panel"
          role="tabpanel"
          aria-labelledby="Tab-{{ section.id }}-all"
        >
          {{ all_panel }}
        </div>

        {%- for block in section.blocks -%}
          <div
            id="TabPanel-{{ section.id }}-{{ block.id }}"
            class="product-showcase__panel"
            role="tabpanel"
            aria-labelledby="Tab-{{ section.id }}-{{ block.id }}"
            hidden
          >
            {%- if show_collections -%}
              {%- assign tab_collection = block.settings.collection -%}
              {%- capture grid -%}
              <ul class="{{ grid_class }}" role="list">
                {% render 'product-showcase-collection-cards',
                  collection: tab_collection,
                  title: block.settings.label,
                  sizes: sizes
                %}
              </ul>
              {%- endcapture -%}
              {% render 'product-showcase-slider', content: grid, enabled: is_slider, rows: section.settings.slider_rows %}
              {%- if section.settings.button_label != blank and tab_collection != blank -%}
                <div class="product-showcase__footer">
                  <a href="{{ tab_collection.url }}" class="product-showcase__button button">
                    {{- section.settings.button_label | escape -}}
                  </a>
                </div>
              {%- endif -%}
            {%- else -%}
            {%- capture grid -%}
            <ul class="{{ grid_class }}" role="list">
              {%- for product in block.settings.collection.products limit: limit -%}
                <li class="product-showcase__item">
                  {% render 'card-product-simple',
                    product: product,
                    section_id: section.id,
                    ratio: ratio,
                    sizes: sizes,
                    show_type: section.settings.show_type,
                    show_subtitle: section.settings.show_subtitle,
                    show_button: section.settings.show_button
                  %}
                </li>
              {%- else -%}
                <li class="product-showcase__empty">{{ 'sections.collection_template.empty' | t }}</li>
              {%- endfor -%}
            </ul>
            {%- endcapture -%}
            {% render 'product-showcase-slider', content: grid, enabled: is_slider, rows: section.settings.slider_rows %}
            {%- if section.settings.button_label != blank and block.settings.collection.products_count > limit -%}
              <div class="product-showcase__footer">
                <a href="{{ block.settings.collection.url }}" class="product-showcase__button button">
                  {{- section.settings.button_label | escape -}}
                </a>
              </div>
            {%- endif -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </product-tabs>
    {%- else -%}
      {{ all_panel }}
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Product showcase",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Best Sellers",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "default": "View All Products",
      "label": "Heading link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Heading link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "link_list",
      "id": "fill_menu",
      "default": "main-menu",
      "label": "Menu for related collections",
      "info": "With the collection being viewed: when it has too few products, the row is filled from its parent and neighbouring collections in this menu."
    },
    {
      "type": "select",
      "id": "sort_order",
      "options": [
        { "value": "collection", "label": "Collection order" },
        { "value": "newest", "label": "Newest first" }
      ],
      "default": "collection",
      "label": "Product order",
      "info": "Newest first shows the most recently added products, e.g. for New Arrivals."
    },
    {
      "type": "checkbox",
      "id": "use_current_collection",
      "default": false,
      "label": "Use the collection being viewed",
      "info": "On collection pages, shows products from that collection instead of the one chosen above. When it has too few, the row is filled from its parent collection (custom.parent metafield)."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.featured-collection.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.featured-collection.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "2",
      "label": "t:sections.featured-collection.settings.columns_mobile.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "grid",
      "label": "Layout",
      "info": "Slider shows arrows when there are more cards than fit."
    },
    {
      "type": "select",
      "id": "slider_rows",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1",
      "label": "Slider rows",
      "info": "Two rows are used only when the cards don't fit in one row."
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "square",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_type",
      "default": false,
      "label": "Show product type"
    },
    {
      "type": "checkbox",
      "id": "show_subtitle",
      "default": true,
      "label": "Show subtitle",
      "info": "Uses the product metafield custom.subtitle."
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "default": true,
      "label": "Show add to cart button"
    },
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "select",
      "id": "tab_content",
      "options": [
        {
          "value": "products",
          "label": "Products"
        },
        {
          "value": "collections",
          "label": "Sub-collections"
        }
      ],
      "default": "products",
      "label": "Tab content",
      "info": "Sub-collections shows image cards for the collections under each tab collection (custom.children) that hold products. The first tab shows the cards of every tab."
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "default": true,
      "label": "Show collection name on cards",
      "info": "Applies to sub-collection cards."
    },
    {
      "type": "text",
      "id": "all_tab_label",
      "default": "All",
      "label": "First tab label",
      "info": "Tabs appear when you add tab blocks. The first tab shows the collection above."
    },
    {
      "type": "header",
      "content": "Bottom button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Shown only when there are more products than the section displays. Uses the collection link when empty. Tabs link to their own collection."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Uses the collection title when empty."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.featured-collection.settings.collection.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product showcase"
    }
  ]
}
{% endschema %}
