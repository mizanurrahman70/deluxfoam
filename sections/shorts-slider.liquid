{{ 'section-shorts-slider.css' | asset_url | stylesheet_tag }}
{%- if section.settings.autoplay -%}
  <script src="{{ 'slider-autoplay.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="shorts page-width section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    style="--shorts-columns: {{ section.settings.columns_desktop }};"
  >
    <div class="shorts__content">
      {%- if section.settings.title != blank -%}
        <h2 class="shorts__title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="shorts__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a
          {% if section.settings.link != blank %}
            href="{{ section.settings.link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="shorts__link"
        >
          {{- section.settings.link_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <slider-autoplay class="shorts__autoplay" data-speed="{% if section.settings.autoplay %}{{ section.settings.autoplay_speed | times: 1000 }}{% else %}0{% endif %}">
    <slider-component class="shorts__slider">
      <ul id="Slider-{{ section.id }}" class="shorts__list list-unstyled" role="list">
        {%- for block in section.blocks -%}
          <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="shorts__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="shorts__card">
            {%- else -%}
              <div class="shorts__card">
            {%- endif -%}
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag:
                  image_size: '600x',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  class: 'shorts__media'
              }}
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 990px) 30vw, 70vw',
                  class: 'shorts__media'
              }}
            {%- else -%}
              {%- assign placeholder_number = forloop.index | minus: 1 | modulo: 2 | plus: 1 -%}
              {{ 'lifestyle-' | append: placeholder_number | placeholder_svg_tag: 'shorts__media placeholder-svg' }}
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.blocks.size > 1 -%}
        <button
          type="button"
          class="shorts__button shorts__button--prev"
          name="previous"
          aria-label="{{ 'general.slider.previous_slide' | t }}"
          aria-controls="Slider-{{ section.id }}"
        >
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
        <button
          type="button"
          class="shorts__button shorts__button--next"
          name="next"
          aria-label="{{ 'general.slider.next_slide' | t }}"
          aria-controls="Slider-{{ section.id }}"
        >
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
      {%- endif -%}
    </slider-component>
    </slider-autoplay>
  </div>
</div>

{% schema %}
{
  "name": "Shorts slider",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Latest shorts",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h0",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Take a glance and grab ideas from our artistic frames.</p>",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "default": "Explore to view more interior ideas",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Cards visible on desktop"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "Auto-rotate slides",
      "info": "Pauses while visitors hover or swipe, and stays off for visitors who prefer reduced motion."
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3,
      "label": "Change slides every"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "short",
      "name": "Short",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Plays muted on a loop. Uses the image when empty."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shorts slider",
      "blocks": [
        { "type": "short" },
        { "type": "short" },
        { "type": "short" },
        { "type": "short" }
      ]
    }
  ]
}
{% endschema %}
