{{ 'section-mattress-calculator.css' | asset_url | stylesheet_tag }}
{{ 'section-foam-calculator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'foam-calculator.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign foams = section.blocks | where: 'type', 'foam'
  assign currency = section.settings.currency_symbol | escape
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <foam-calculator
    class="mattress-calc foam-calc page-width section-{{ section.id }}-padding"
    data-currency="{{ currency }}"
    data-discount="{{ section.settings.discount }}"
  >
    <div class="mattress-calc__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mattress-calc__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="mattress-calc__title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="mattress-calc__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Foam size {%- endcomment -%}
    <div class="mattress-calc__panel">
      <h2 class="mattress-calc__label">{{ 'sections.foam_calculator.size' | t }}</h2>

      <div class="mattress-calc__presets" role="group" aria-label="{{ 'sections.foam_calculator.size' | t }}">
        {%- assign presets = ':72:36,:78:36,:78:42,:78:48,:78:60,:84:60,:84:72,Pillow:22:22' | split: ',' -%}
        {%- for preset in presets -%}
          {%- assign p = preset | split: ':' -%}
          <button type="button" class="mattress-calc__chip" data-length="{{ p[1] }}" data-width="{{ p[2] }}">
            {%- if p[0] != blank -%}{{ p[0] }} <small>{{ p[1] }}″×{{ p[2] }}″</small>{%- else -%}{{ p[1] }}″×{{ p[2] }}″{%- endif -%}
          </button>
        {%- endfor -%}
      </div>

      <div class="mattress-calc__dims">
        <div class="mattress-calc__dim">
          <span class="mattress-calc__dim-label">{{ 'sections.mattress_calculator.length' | t }}</span>
          <div class="mattress-calc__pair">
            <label class="mattress-calc__field">
              <span class="visually-hidden">{{ 'sections.mattress_calculator.length' | t }} (ft)</span>
              <input type="number" inputmode="numeric" min="0" step="1" value="6" data-input="lenFt">
              <span class="mattress-calc__unit" aria-hidden="true">ft</span>
            </label>
            <label class="mattress-calc__field">
              <span class="visually-hidden">{{ 'sections.mattress_calculator.length' | t }} (in)</span>
              <input type="number" inputmode="decimal" min="0" max="11.5" step="0.5" value="6" data-input="lenIn">
              <span class="mattress-calc__unit" aria-hidden="true">in</span>
            </label>
          </div>
          <p class="mattress-calc__hint">6 ft 6 in = 78″</p>
        </div>

        <div class="mattress-calc__dim">
          <span class="mattress-calc__dim-label">{{ 'sections.mattress_calculator.width' | t }}</span>
          <div class="mattress-calc__pair">
            <label class="mattress-calc__field">
              <span class="visually-hidden">{{ 'sections.mattress_calculator.width' | t }} (ft)</span>
              <input type="number" inputmode="numeric" min="0" step="1" value="5" data-input="widFt">
              <span class="mattress-calc__unit" aria-hidden="true">ft</span>
            </label>
            <label class="mattress-calc__field">
              <span class="visually-hidden">{{ 'sections.mattress_calculator.width' | t }} (in)</span>
              <input type="number" inputmode="decimal" min="0" max="11.5" step="0.5" value="0" data-input="widIn">
              <span class="mattress-calc__unit" aria-hidden="true">in</span>
            </label>
          </div>
          <p class="mattress-calc__hint">5 ft 0 in = 60″</p>
        </div>

        <div class="mattress-calc__dim">
          <span class="mattress-calc__dim-label">{{ 'sections.foam_calculator.thickness' | t }}</span>
          <div class="mattress-calc__pair">
            <label class="mattress-calc__field">
              <span class="visually-hidden">{{ 'sections.foam_calculator.thickness' | t }} (in)</span>
              <input type="number" inputmode="decimal" min="0.5" step="0.5" value="4" data-input="thickIn">
              <span class="mattress-calc__unit" aria-hidden="true">in</span>
            </label>
          </div>
          <div class="foam-calc__thick-chips" role="group" aria-label="{{ 'sections.foam_calculator.thickness' | t }}">
            {%- for t in (1..4) -%}
              <button type="button" class="foam-calc__thick-chip" data-thickness="{{ t }}">{{ t }}″</button>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.show_discount_input -%}
          <div class="mattress-calc__dim mattress-calc__dim--accent">
            <span class="mattress-calc__dim-label">{{ 'sections.mattress_calculator.discount' | t }}</span>
            <div class="mattress-calc__pair">
              <label class="mattress-calc__field">
                <span class="visually-hidden">{{ 'sections.mattress_calculator.discount' | t }} (%)</span>
                <input type="number" inputmode="numeric" min="0" max="90" step="1" value="{{ section.settings.discount }}" data-input="discPct">
                <span class="mattress-calc__unit" aria-hidden="true">%</span>
              </label>
            </div>
            <p class="mattress-calc__hint">{{ 'sections.mattress_calculator.discount_hint' | t }}</p>
          </div>
        {%- endif -%}
      </div>

      <div class="mattress-calc__summary foam-calc__summary--two" aria-live="polite">
        <div class="mattress-calc__stat">
          <span class="mattress-calc__stat-value" data-output="size">78″ × 60″ × 4″</span>
          <span class="mattress-calc__stat-label">{{ 'sections.foam_calculator.size' | t }}</span>
        </div>
        <div class="mattress-calc__stat">
          <span class="mattress-calc__stat-value" data-output="cft">10.83</span>
          <span class="mattress-calc__stat-label">CFT (L × W × T)</span>
        </div>
      </div>
    </div>

    {%- comment -%} Foam prices {%- endcomment -%}
    {%- if foams.size > 0 -%}
      <div class="mattress-calc__group">
        <div class="mattress-calc__group-head">
          <span class="mattress-calc__badge mattress-calc__badge--ortho">CFT</span>
          <h2 class="mattress-calc__group-title h3">{{ section.settings.foam_title | escape }}</h2>
          <span class="mattress-calc__basis">{{ 'sections.mattress_calculator.price_basis' | t: unit: 'CFT' }}</span>
        </div>
        <ul class="mattress-calc__cards list-unstyled" role="list">
          {%- for block in foams -%}
            <li class="mattress-calc__card mattress-calc__card--ortho" data-rate="{{ block.settings.rate }}" data-calc="size" {{ block.shopify_attributes }}>
              {% render 'foam-calculator-card-head', block: block, currency: currency %}
              <div class="mattress-calc__prices">
                <p class="mattress-calc__mrp">
                  <span class="mattress-calc__price-label">{{ 'sections.mattress_calculator.mrp' | t }}</span>
                  <s data-output="mrp">—</s>
                </p>
                <p class="mattress-calc__offer">
                  <span class="mattress-calc__price-label">{{ 'sections.mattress_calculator.offer' | t }} · <span data-output="pct">{{ section.settings.discount }}</span>%</span>
                  <span class="mattress-calc__offer-value" data-output="offer">—</span>
                </p>
              </div>
              <p class="mattress-calc__formula" data-output="formula"></p>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- comment -%} Homely Package: full sofa set {%- endcomment -%}
    {%- if section.settings.show_package and foams.size > 0 -%}
      <div class="mattress-calc__group foam-calc__package">
        <div class="foam-calc__banner">
          <span class="foam-calc__banner-icon" aria-hidden="true">{{- 'icon-heart.svg' | inline_asset_content -}}</span>
          <div>
            <p class="foam-calc__banner-title">{{ section.settings.package_title | escape }}</p>
            <p class="foam-calc__banner-text">{{ section.settings.package_text | escape }}</p>
          </div>
        </div>

        <div class="mattress-calc__group-head">
          <span class="mattress-calc__badge mattress-calc__badge--spring">SET</span>
          <h2 class="mattress-calc__group-title h3">{{ 'sections.foam_calculator.package_heading' | t }}</h2>
          <span class="mattress-calc__basis">{{ 'sections.foam_calculator.package_basis' | t }}</span>
        </div>

        <div class="mattress-calc__panel">
          <h3 class="mattress-calc__label">{{ 'sections.foam_calculator.combination' | t }}</h3>
          <div class="mattress-calc__presets" role="group" aria-label="{{ 'sections.foam_calculator.combination' | t }}">
            {%- assign combos = '3 + 2 + 1:6,2 + 2 + 2:6,2 + 2 + 1:5,3 + 1 + 1:5,2 + 1 + 1:4,1 + 1 + 1:3' | split: ',' -%}
            {%- for combo in combos -%}
              {%- assign c = combo | split: ':' -%}
              {%- assign foam_count = c[1] | times: 2 -%}
              <button
                type="button"
                class="mattress-calc__chip{% if c[0] == '2 + 2 + 1' %} is-active{% endif %}"
                data-seats="{{ c[1] }}"
                aria-pressed="{% if c[0] == '2 + 2 + 1' %}true{% else %}false{% endif %}"
              >
                {{ c[0] }} <small>{{ 'sections.foam_calculator.seats_foams' | t: seats: c[1], foams: foam_count }}</small>
              </button>
            {%- endfor -%}
          </div>

          <div class="mattress-calc__dims foam-calc__sofa-dims">
            {%- assign parts = 'seat,back' | split: ',' -%}
            {%- for part in parts -%}
              {%- liquid
                if part == 'seat'
                  assign d_l = section.settings.seat_length
                  assign d_w = section.settings.seat_width
                  assign d_t = section.settings.seat_thickness
                  assign label_key = 'sections.foam_calculator.seat_size'
                else
                  assign d_l = section.settings.back_length
                  assign d_w = section.settings.back_width
                  assign d_t = section.settings.back_thickness
                  assign label_key = 'sections.foam_calculator.back_size'
                endif
              -%}
              <div class="mattress-calc__dim">
                <span class="mattress-calc__dim-label">{{ label_key | t }}</span>
                <div class="mattress-calc__pair">
                  <label class="mattress-calc__field">
                    <span class="visually-hidden">{{ label_key | t }} (length)</span>
                    <input type="number" inputmode="decimal" min="1" step="0.5" value="{{ d_l }}" data-input="{{ part }}L">
                    <span class="mattress-calc__unit" aria-hidden="true">L″</span>
                  </label>
                  <label class="mattress-calc__field">
                    <span class="visually-hidden">{{ label_key | t }} (width)</span>
                    <input type="number" inputmode="decimal" min="1" step="0.5" value="{{ d_w }}" data-input="{{ part }}W">
                    <span class="mattress-calc__unit" aria-hidden="true">W″</span>
                  </label>
                  <label class="mattress-calc__field">
                    <span class="visually-hidden">{{ label_key | t }} (thickness)</span>
                    <input type="number" inputmode="decimal" min="0.5" step="0.5" value="{{ d_t }}" data-input="{{ part }}T">
                    <span class="mattress-calc__unit" aria-hidden="true">T″</span>
                  </label>
                </div>
                <p class="mattress-calc__hint">{{ 'sections.foam_calculator.one_per_seat' | t }}</p>
              </div>
            {%- endfor -%}
          </div>

          <div class="mattress-calc__summary" aria-live="polite">
            <div class="mattress-calc__stat">
              <span class="mattress-calc__stat-value" data-output="pieces">10</span>
              <span class="mattress-calc__stat-label">{{ 'sections.foam_calculator.total_foams' | t }}</span>
            </div>
            <div class="mattress-calc__stat">
              <span class="mattress-calc__stat-value" data-output="split">5 + 5</span>
              <span class="mattress-calc__stat-label">{{ 'sections.foam_calculator.seat_back' | t }}</span>
            </div>
            <div class="mattress-calc__stat">
              <span class="mattress-calc__stat-value" data-output="package-cft">0.00</span>
              <span class="mattress-calc__stat-label">{{ 'sections.foam_calculator.total_cft' | t }}</span>
            </div>
          </div>
        </div>

        <ul class="mattress-calc__cards foam-calc__package-cards list-unstyled" role="list">
          {%- for block in foams -%}
            <li class="mattress-calc__card mattress-calc__card--spring" data-rate="{{ block.settings.rate }}" data-calc="package">
              {% render 'foam-calculator-card-head', block: block, currency: currency %}
              <p class="mattress-calc__meta" data-output="breakdown"></p>
              <div class="mattress-calc__prices">
                <p class="mattress-calc__mrp">
                  <span class="mattress-calc__price-label">{{ 'sections.mattress_calculator.mrp' | t }}</span>
                  <s data-output="mrp">—</s>
                </p>
                <p class="mattress-calc__offer">
                  <span class="mattress-calc__price-label">{{ 'sections.foam_calculator.package_price' | t }} · <span data-output="pct">{{ section.settings.discount }}</span>%</span>
                  <span class="mattress-calc__offer-value" data-output="offer">—</span>
                </p>
              </div>
              <p class="mattress-calc__formula" data-output="formula"></p>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if section.settings.contact != blank -%}
      <div class="mattress-calc__contact rte">{{ section.settings.contact }}</div>
    {%- endif -%}
  </foam-calculator>
</div>

{% schema %}
{
  "name": "Foam calculator",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "eyebrow", "default": "Price calculator", "label": "Small label" },
    { "type": "text", "id": "title", "default": "Foam Price Calculator", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h0",
      "label": "t:sections.all.heading_size.label"
    },
    { "type": "text", "id": "subtitle", "default": "Enter any size to see the price of every foam. Rates in Tk per CFT.", "label": "Text" },
    { "type": "text", "id": "foam_title", "default": "Foam Prices", "label": "Foam list title" },
    { "type": "header", "content": "Pricing" },
    { "type": "text", "id": "currency_symbol", "default": "৳", "label": "Currency symbol" },
    {
      "type": "range",
      "id": "discount",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 25,
      "label": "Offer discount",
      "info": "Off MRP. Set 0 to show MRP only."
    },
    {
      "type": "checkbox",
      "id": "show_discount_input",
      "default": false,
      "label": "Let visitors change the discount",
      "info": "Useful for an internal sales page. Leave off on the public store."
    },
    { "type": "header", "content": "Homely Package" },
    { "type": "checkbox", "id": "show_package", "default": true, "label": "Show sofa set package" },
    { "type": "text", "id": "package_title", "default": "Homely Package", "label": "Banner title" },
    { "type": "text", "id": "package_text", "default": "Replace all your sofa foams in one go — complete set pricing for your home.", "label": "Banner text" },
    { "type": "number", "id": "seat_length", "default": 22, "label": "Seat foam length (in)" },
    { "type": "number", "id": "seat_width", "default": 22, "label": "Seat foam width (in)" },
    { "type": "number", "id": "seat_thickness", "default": 4, "label": "Seat foam thickness (in)" },
    { "type": "number", "id": "back_length", "default": 22, "label": "Back foam length (in)" },
    { "type": "number", "id": "back_width", "default": 18, "label": "Back foam width (in)" },
    { "type": "number", "id": "back_thickness", "default": 3, "label": "Back foam thickness (in)" },
    {
      "type": "richtext",
      "id": "contact",
      "default": "<p><strong>New Delux Foam</strong> · Cha-104/1, North Badda, Munshi Bari Pragati Sarani, Dhaka-1212 · 01304-736351 · 01918-401714</p>",
      "label": "Contact text"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "foam",
      "name": "Foam",
      "settings": [
        { "type": "text", "id": "name", "default": "Delux foam", "label": "Name" },
        { "type": "text", "id": "foam_type", "default": "Poly foam", "label": "Type" },
        { "type": "number", "id": "rate", "default": 500, "label": "Rate per CFT" },
        { "type": "product", "id": "product", "label": "Linked product", "info": "Optional. Adds a View product link." }
      ]
    }
  ],
  "presets": [
    { "name": "Foam calculator" }
  ]
}
{% endschema %}
