{{ 'component-contact-details.css' | asset_url | stylesheet_tag }}
{{ 'section-contact-info.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign map_query = settings.contact_address | strip_newlines | url_encode
  assign show_map = false
  if section.settings.show_map and settings.contact_address != blank
    assign show_map = true
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact-info page-width section-{{ section.id }}-padding{% unless show_map %} contact-info--no-map{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="contact-info__details">
      {%- if section.settings.heading != blank -%}
        <h2 class="contact-info__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="contact-info__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {% render 'contact-details', class: 'contact-details--page', show_labels: true %}
    </div>

    {%- if show_map -%}
      <div class="contact-info__map" style="--map-height: {{ section.settings.map_height }}px;">
        <iframe
          src="https://maps.google.com/maps?q={{ map_query }}&z=15&output=embed"
          title="{{ settings.contact_address | strip_newlines | escape }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="contact-outlets page-width section-{{ section.id }}-padding">
      {%- if section.settings.outlets_heading != blank -%}
        <h2 class="contact-outlets__heading h2">{{ section.settings.outlets_heading | escape }}</h2>
      {%- endif -%}
      <ul class="contact-outlets__grid list-unstyled" role="list">
        {%- for block in section.blocks -%}
          <li
            class="contact-outlet{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {% render 'contact-outlet', block: block %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Contact information",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Edit the address, mobile, WhatsApp and email in Theme settings > Contact information."
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Get in touch",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Visit our showroom, call or message us on WhatsApp. We're happy to help with sizes, fabrics and prices.</p>",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "show_map",
      "default": true,
      "label": "Show map"
    },
    {
      "type": "range",
      "id": "map_height",
      "min": 240,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 400,
      "label": "Map height"
    },
    {
      "type": "text",
      "id": "outlets_heading",
      "default": "Our outlets",
      "label": "Outlets heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "outlet",
      "name": "Outlet",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "default": "Showroom",
          "label": "Name"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "textarea",
          "id": "contacts",
          "label": "Contacts",
          "info": "One per line, as: number - name. Example: 01805833370 - Mr. Nayeem Ahmed"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact information"
    }
  ]
}
{% endschema %}
