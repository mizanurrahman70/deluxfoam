{{ 'section-category-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-section-heading.css' | asset_url | stylesheet_tag }}
{%- if section.settings.autoplay -%}
  <script src="{{ 'slider-autoplay.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{{ 'component-card-product-simple.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_button -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    else
      assign ratio = '4 / 5'
  endcase
  assign columns = section.settings.columns_desktop

  assign autoplay_speed = 0
  if section.settings.autoplay
    assign autoplay_speed = section.settings.autoplay_speed | times: 1000
  endif

  comment
    "View all" goes to the product's own collection. The recommendations request has no product
    context, so it falls back to all products there.
  endcomment
  assign view_all_url = section.settings.link_url
  if view_all_url == blank and product.collections.size > 0
    assign view_all_url = product.collections.first.url
  endif
  if view_all_url == blank
    assign view_all_url = routes.all_products_collection_url
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <product-recommendations
    class="category-slider page-width section-{{ section.id }}-padding"
    style="--category-columns: {{ columns }};"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {%- comment -%}
      The page first renders a filled row from the product's collection, topped up with other products.
      Shopify's recommendations replace it only when there are enough of them to fill a row;
      otherwise this section renders nothing for the recommendations request and the first row stays.
    {%- endcomment -%}
    {%- if recommendations.performed -%}
      {%- if recommendations.products_count >= columns -%}
        {% render 'products-slider',
          products: recommendations.products,
          section: section,
          ratio: ratio,
          limit: section.settings.products_to_show,
          link_label: section.settings.link_label,
          link_url: view_all_url,
          autoplay_speed: autoplay_speed
        %}
      {%- endif -%}
    {%- elsif product -%}
      {%- liquid
        assign pool = collections.all.products
        if product.collections.size > 0
          assign pool = product.collections.first.products | concat: pool
        endif
        if section.settings.fallback_collection != blank
          assign pool = section.settings.fallback_collection.products | concat: pool
        endif
      -%}
      {% render 'products-slider',
        products: pool,
        section: section,
        ratio: ratio,
        limit: section.settings.products_to_show,
        exclude_id: product.id,
        link_label: section.settings.link_label,
        link_url: view_all_url,
        autoplay_speed: autoplay_speed
      %}
    {%- endif -%}
  </product-recommendations>
</div>

{% schema %}
{
  "name": "Recommendations slider",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Recommendations come from Shopify and improve over time. You can set them manually with the Search & Discovery app."
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "You May Also Like",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "intent",
      "options": [
        {
          "value": "related",
          "label": "Related"
        },
        {
          "value": "complementary",
          "label": "Complementary"
        }
      ],
      "default": "related",
      "label": "Recommendation type"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Shown first when Shopify has too few recommendations. The row is then filled from the product's collection and all products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 8,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Cards visible on desktop"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "portrait",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_type",
      "default": true,
      "label": "Show product type"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "default": false,
      "label": "Show add to cart button"
    },
    {
      "type": "text",
      "id": "link_label",
      "default": "View All Products",
      "label": "View all link label",
      "info": "Leave empty to hide the link."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "View all link",
      "info": "Uses the product's collection when empty."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "Auto-rotate slides",
      "info": "Pauses while visitors hover or swipe, and stays off for visitors who prefer reduced motion."
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3,
      "label": "Change slides every"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Recommendations slider"
    }
  ]
}
{% endschema %}
