{{ 'section-category-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-card-product-simple.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_button -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    else
      assign ratio = '4 / 5'
  endcase
  assign columns = section.settings.columns_desktop
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <product-recommendations
    class="category-slider page-width section-{{ section.id }}-padding"
    style="--category-columns: {{ columns }};"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {% render 'products-slider',
        products: recommendations.products,
        section: section,
        ratio: ratio,
        limit: section.settings.products_to_show
      %}
    {%- elsif product -%}
      {%- comment -%}
        Shown until Shopify returns recommendations, and kept when it returns none.
      {%- endcomment -%}
      {%- assign fallback = section.settings.fallback_collection | default: product.collections.first -%}
      {%- if fallback != blank -%}
        {% render 'products-slider',
          products: fallback.products,
          section: section,
          ratio: ratio,
          limit: section.settings.products_to_show,
          exclude_id: product.id
        %}
      {%- endif -%}
    {%- endif -%}
  </product-recommendations>
</div>

{% schema %}
{
  "name": "Recommendations slider",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Recommendations come from Shopify and improve over time. You can set them manually with the Search & Discovery app."
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "You May Also Like",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "intent",
      "options": [
        {
          "value": "related",
          "label": "Related"
        },
        {
          "value": "complementary",
          "label": "Complementary"
        }
      ],
      "default": "related",
      "label": "Recommendation type"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Shown when Shopify has no recommendations yet. Uses the product's first collection when empty."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 8,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Cards visible on desktop"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "portrait",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_type",
      "default": true,
      "label": "Show product type"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "default": false,
      "label": "Show add to cart button"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Recommendations slider"
    }
  ]
}
{% endschema %}
